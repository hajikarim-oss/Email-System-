{
  "framework": "vite",
  "installCommand": "npx pnpm@9.15.4 --dir web install --prefer-frozen-lockfile",
  "buildCommand": "npx pnpm@9.15.4 --dir web build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
