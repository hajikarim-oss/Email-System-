# Smartlead API credentials (server/smartleadKeys.ts).
# Copy to `.env` (git-ignored) for local dev; set the same names in Vercel
# Project Settings -> Environment Variables for deployments.
SMARTLEAD_API_KEY=
# Preeti's dedicated sending account; campaigns from her mailbox use this key.
SMARTLEAD_SECONDARY_API_KEY=
# Optional daily lead cap written into Smartlead campaign schedules.
# Defaults to 200 (4 mailboxes x 50/day). Raise for a bigger mailbox pool.
# SMARTLEAD_MAX_NEW_LEADS_PER_DAY=200
# Postgres connection string (server/pg.ts reads DATABASE_URL from .env too).
# DATABASE_URL=postgres://user:password@host:5432/db
