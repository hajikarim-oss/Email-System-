# ─────────────────────────────────────────────
# NEXUS OUTBOUND — ENVIRONMENT VARIABLES
# Copy this to Vercel's Environment Variables dashboard
# ─────────────────────────────────────────────

# 1. Supabase PostgreSQL Database Connection
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# 2. Redis (Upstash) Rate Limiter
REDIS_URL="https://..."
REDIS_TOKEN="..."

# 3. NextAuth & Application Security
# IMPORTANT: Set NEXTAUTH_URL to your Vercel deployment URL
# Example: https://nexus-outbound.vercel.app
NEXTAUTH_URL="https://your-app.vercel.app"
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-secret-here"
AUTH_SECRET="same-as-nextauth-secret"
AUTH_TRUST_HOST=true
ENCRYPTION_KEY="generate-a-random-64-char-hex-string"

# 4. Google OAuth Workspace Login
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# 5. Smartlead API & Webhooks
SMARTLEAD_API_KEY="..."
SMARTLEAD_API_URL="https://server.smartlead.ai/api/v1"
SMARTLEAD_WEBHOOK_SECRET="..."

# 6. OpenAI API Key (Optional - for AI features)
OPENAI_API_KEY="..."

# 7. WhatsApp Cloud API (Optional - for alerts)
WHATSAPP_API_URL="..."
WHATSAPP_API_TOKEN="..."
WHATSAPP_ALERT_PHONE="..."
